# Application Environment
APP_NAME="Portfolio Idriss"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=idriss_code_portfolio
DB_USERNAME=root
DB_PASSWORD=

# JWT/Security
JWT_SECRET=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE=7200

# Email Configuration
MAIL_FROM=idriss@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# API Configuration
API_URL=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,gif,pdf

# Session
SESSION_LIFETIME=1440
